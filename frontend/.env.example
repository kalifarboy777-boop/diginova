# URL publique du site (métadonnées, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API Laravel (utilisée par le proxy /api et par les Server Components)
BACKEND_URL=http://127.0.0.1:8000
# 1 = afficher la connexion Google (GOOGLE_CLIENT_ID/SECRET configurés côté backend)
NEXT_PUBLIC_GOOGLE_AUTH=0
# 1 = activer les événements analytics (lib/analytics.ts)
NEXT_PUBLIC_ANALYTICS=0
